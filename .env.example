# Local: download the service-account JSON from Firebase Project settings,
# rename it to firebase-service-account.json, and place it in this folder.
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
FIREBASE_DATABASE_URL="https://koc2-20fb8-default-rtdb.firebaseio.com"

# Deploying to Netlify/Vercel/etc (no local file): set these individual
# variables instead of FIREBASE_SERVICE_ACCOUNT_PATH, using the values from
# the same service-account JSON (project_id, client_email, private_key).
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
#
# For FIREBASE_PRIVATE_KEY specifically: platforms' env var UIs often mangle a
# pasted multi-line PEM key's line breaks, which makes Node reject it with
# "error:1E08010C:DECODER routines::unsupported". To avoid that, base64-encode
# the private_key value and set FIREBASE_PRIVATE_KEY_BASE64 instead (used in
# preference to FIREBASE_PRIVATE_KEY when set) - it's a single unbroken line
# that can't be corrupted by line-break handling. Generate it with:
#   node -e "console.log(Buffer.from(require('./firebase-service-account.json').private_key).toString('base64'))"
# FIREBASE_PRIVATE_KEY_BASE64="paste the base64 output here"

# One simple administrator login. Used by `npm run db:seed`; the resulting
# scrypt password hash is stored in Realtime Database, never the plain-text password.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe#12345"

# Optional second login for whoever reads the electricity meters each month. This
# account can only view/edit meter readings (prev/curr reading, paid/unpaid) — it
# cannot see rent, tenant contact info, notes, or any other admin screens. Leave
# unset if you don't need a separate reader login.
SECURITY_USERNAME="security"
SECURITY_PASSWORD="ChangeMe#67890"

# A random secret of at least 32 characters for the signed login cookie.
# Example: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"
BUILDING_NAME="SJR Building"

# First month (YYYY-MM) the building had any rentable units. The month picker on
# every page never offers an earlier month than this. Requires a rebuild to change.
NEXT_PUBLIC_BUILDING_READY_MONTH="2026-05"
