# Firebase service account (Firebase Console > Project settings > Service accounts).
FIREBASE_PROJECT_ID="koc2-20fb8"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@koc2-20fb8.iam.gserviceaccount.com"
# Keep quoted. Netlify requires the private-key line breaks as literal \\n characters.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# One simple administrator login. Used by `npm run db:seed`; the resulting
# scrypt password hash is stored in Firestore, never the plain-text password.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe#12345"

# A random secret of at least 32 characters for the signed login cookie.
# Example: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"
BUILDING_NAME="SJR Building"
