# Firebase Realtime Database URL for your project, e.g.
# https://your-project-id-default-rtdb.firebaseio.com
# (Firebase console → Realtime Database → copy the URL shown at the top.)
FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"

# --- Service account credentials (choose ONE of the two below) ---
#
# Firebase console → Project settings → Service accounts → Generate new
# private key. This downloads a JSON file — NEVER commit it to git.
#
# Recommended for deployment (Vercel/Netlify): paste the entire downloaded
# JSON file's contents as a single-line string here.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}'
#
# Alternative for local dev only: save the downloaded file locally
# (e.g. firebase-service-account.json, already gitignored) and point to it
# instead of using FIREBASE_SERVICE_ACCOUNT_JSON.
# FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Long, random secret used to sign admin session cookies (HS256 JWT).
# Generate one with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# Displayed on the public page and API.
BUILDING_NAME="SJR Building"

# Used only by `npm run db:seed` to set the initial password for the three
# fixed admin usernames (admin1, admin2, admin3). Change these before seeding,
# and change the passwords again after first login (see README
# "Changing admin passwords").
ADMIN1_PASSWORD="ChangeMe#Admin1"
ADMIN2_PASSWORD="ChangeMe#Admin2"
ADMIN3_PASSWORD="ChangeMe#Admin3"
