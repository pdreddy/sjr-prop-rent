// Prisma schema for SJR Rent Tracker
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

model Admin {
  id                  String    @id @default(cuid())
  username            String    @unique
  passwordHash        String    @map("password_hash")
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("admins")
}

model Unit {
  id           String   @id @default(cuid())
  plotNumber   String   @unique @map("plot_number")
  tenantName   String?  @map("tenant_name")
  moveInDate   DateTime? @map("move_in_date")
  phone        String?
  monthlyRent  Decimal  @default(0) @map("monthly_rent") @db.Decimal(10, 2)
  maintenanceAmount Decimal @default(0) @map("maintenance_amount") @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  payments Payment[]

  @@map("units")
}

model Payment {
  id            String        @id @default(cuid())
  unitId        String        @map("unit_id")
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  month         String        @map("month") // format: "YYYY-MM"
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  rentAmount    Decimal       @default(0) @map("rent_amount") @db.Decimal(10, 2)
  maintenanceAmount Decimal   @default(0) @map("maintenance_amount") @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(10, 2)
  balanceDue    Decimal       @default(0) @map("balance_due") @db.Decimal(10, 2)
  paidDate      DateTime?     @map("paid_date")
  notes         String?
  updatedBy     String?       @map("updated_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([unitId, month])
  @@index([month])
  @@map("payments")
}

model AuditLog {
  id             String   @id @default(cuid())
  adminId        String?  @map("admin_id")
  admin          Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action         String
  recordType     String   @map("record_type")
  recordId       String?  @map("record_id")
  previousValue  Json?    @map("previous_value")
  newValue       Json?    @map("new_value")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([recordType, recordId])
  @@map("audit_logs")
}
